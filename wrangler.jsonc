{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Single source-of-truth Wrangler config, the same shape as sportsline: the
  // @cloudflare/vite-plugin reads this for dev + `vite build` (which requires
  // `main` to be the source entry), and the production deploy passes the
  // built bundle as wrangler's positional script arg, which overrides `main`:
  //   wrangler deploy dist/server/index.js --env production
  //
  // There is no staging environment. Bindings and settings are NOT inherited
  // into named environments, so the production env repeats them.
  "name": "budgy",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": "./dist/client",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "budgy-db",
      "database_id": "b2206e5f-72a5-4e6b-a349-21485511cae7",
      "migrations_dir": "drizzle",
    },
  ],
  // Workers Rate Limiting for the token endpoints (src/lib/rateLimit.ts).
  // namespace_id is ours to choose, unique in the Cloudflare account.
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "4101",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "4102",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // SimpleFIN sync (docs/adr/0012): the cron queues one message per bank
  // connection; this Worker consumes them one at a time. A message that keeps
  // failing (or crashes the consumer) lands in the dead-letter queue.
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "budgy-sync" }],
    "consumers": [
      {
        "queue": "budgy-sync",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 2,
        "dead_letter_queue": "budgy-sync-dlq",
      },
    ],
  },
  "env": {
    "production": {
      "name": "budgy",
      // Production is budgy.bid (a Custom Domain, declared here so every
      // deploy keeps it, as sportsline does). www and workers.dev stay on but
      // redirect to it (src/server.ts, CANONICAL_HOST).
      "workers_dev": true,
      "routes": [
        {
          "pattern": "budgy.bid",
          "custom_domain": true,
        },
        {
          "pattern": "www.budgy.bid",
          "custom_domain": true,
        },
      ],
      // Requests on any other host (www, workers.dev) redirect here.
      "vars": {
        "CANONICAL_HOST": "budgy.bid",
      },
      // Queue a sync of each linked SimpleFIN connection four times a day
      // (docs/adr/0012), off the hour as SimpleFIN asks.
      "triggers": {
        "crons": ["17 */6 * * *"],
      },
      // As at the top level (docs/adr/0012).
      "queues": {
        "producers": [{ "binding": "SYNC_QUEUE", "queue": "budgy-sync" }],
        "consumers": [
          {
            "queue": "budgy-sync",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "max_concurrency": 2,
            "dead_letter_queue": "budgy-sync-dlq",
          },
        ],
      },
      "observability": {
        "logs": {
          "enabled": true,
        },
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "budgy-db",
          "database_id": "b2206e5f-72a5-4e6b-a349-21485511cae7",
          "migrations_dir": "drizzle",
        },
      ],
      // As at the top level (src/lib/rateLimit.ts).
      "ratelimits": [
        {
          "name": "MCP_RATE_LIMITER",
          "namespace_id": "4101",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "UPLOAD_RATE_LIMITER",
          "namespace_id": "4102",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
  },
}
